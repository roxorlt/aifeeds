# Dependencies
node_modules/

# Build outputs
dashboard/dist/
dashboard/output/playwright/
dashboard/output/home-view-benchmarks/
worker/dist/

# Runtime data
data/
exports/

# Secrets — NEVER commit
.env
*.env
.dev.vars
worker/.dev.vars
.secrets/

# Wrangler / CF runtime
.wrangler/
worker/.wrangler/

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp

# Logs
*.log

# Pytest / python caches
__pycache__/
*.pyc

# Scraped content (contains URLs / private data)
notes/
keywords-learned-*.txt

# Dashboard screenshots (dev artifacts)
dashboard-*.png
x-com-tweet.png

# Local editor / MCP state
.claude/
.mcp.json
.playwright-mcp/
.superpowers/
.worktrees/

.dev.vars*
!.dev.vars.example
!.env.example

# dashboard/.env.staging 只含公开 URL(VITE_API_BASE=staging-api),无 secret,
# 必须保持跟踪:worktree / CI 构建缺它 → VITE_API_BASE 为空 → staging 前端 base
# 解析全靠运行时兜底(2026-07-05 登录死循环事故根因)。显式反跟踪,防止未来把上面
# *.env 收紧成 .env* 时再次静默把它漏出构建。
!dashboard/.env.staging

# wrangler 4.x 在主仓库根自动生成的 jsonc，跟 worker/wrangler.toml 冲突
wrangler.jsonc

# 仓库根没 package.json，npm 误生成的空 lock 是噪音
/package-lock.json

# events 健康度脚本（别 session 在用，先 ignore 避免噪音）
scripts/events_health.py
