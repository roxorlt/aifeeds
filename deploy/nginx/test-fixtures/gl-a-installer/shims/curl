#!/usr/bin/env bash
set -euo pipefail

scenario=${GL_A_SCENARIO:?}
state_dir=/tmp/gl-a-test
mkdir -p "$state_dir"

if [ "$scenario" = concurrent-lock ] && mkdir "$state_dir/concurrent-once" 2>/dev/null; then
    : > "$state_dir/concurrent-ready"
    while [ ! -e "$state_dir/concurrent-release" ]; do
        sleep 0.05
    done
fi

arguments=()
host=''
probe_header=0
index=1
while [ "$index" -le "$#" ]; do
    argument=${!index}
    if [ "$argument" = -H ]; then
        next_index=$((index + 1))
        header=${!next_index}
        case "$header" in
            [Xx]-[Aa]ifeeds-[Pp]erf-[Pp]robe:*)
                probe_header=1
                if [ "$scenario" = negative-probe-find-error ] \
                    && [ -e "$state_dir/negative-probe-enabled" ] \
                    && case "$header" in *upstream-*) true ;; *) false ;; esac \
                    && [ -z "$(/usr/bin/find /var/log/nginx -maxdepth 1 -type f \
                        -name 'aifeeds-performance.jsonl*' -print -quit)" ]; then
                    : > "$state_dir/negative-find-window"
                fi
                if [ "$scenario" != probe-missing ]; then
                    arguments+=("$argument" "$header")
                else
                    : > "$state_dir/probe-missing-injected"
                fi
                index=$((index + 2))
                continue
                ;;
        esac
    fi
    case "$argument" in
        https://ai-feeds.com/*)
            host=ai-feeds.com
            arguments+=("http://127.0.0.1:8080/${argument#https://ai-feeds.com/}")
            ;;
        https://api.ai-feeds.com/*)
            host=api.ai-feeds.com
            arguments+=("http://127.0.0.1:8080/${argument#https://api.ai-feeds.com/}")
            ;;
        *) arguments+=("$argument") ;;
    esac
    index=$((index + 1))
done

test -n "$host"

if [ "$scenario" = term ] && [ "$probe_header" -eq 1 ] \
    && mkdir "$state_dir/term-once" 2>/dev/null; then
    : > "$state_dir/term-ready"
    while :; do sleep 1; done
fi

exec /usr/bin/curl "${arguments[@]}" -H "Host: $host"
