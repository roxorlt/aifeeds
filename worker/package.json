{
  "name": "xlist-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run && node --test scripts/build-publication-inventory.test.mjs scripts/publication-gate-config.test.mjs scripts/publication-inventory-artifact.test.mjs",
    "predeploy": "bash ../scripts/predeploy-check.sh",
    "deploy": "wrangler deploy",
    "deploy:publication:bootstrap": "wrangler deploy",
    "deploy:publication:drain": "wrangler deploy --var PUBLICATION_CAPACITY_WARNING_DRAIN_ENABLED:1 --var PUBLICATION_CAPACITY_WARNING_PRODUCER_ENABLED:0 --var DAILY_PUBLICATION_RESERVATION_ENABLED:0 --var DAILY_PUBLICATION_PUT_ENABLED:0 --var DAILY_PUBLICATION_PROMOTION_ENABLED:0",
    "deploy:publication:producer": "wrangler deploy --var PUBLICATION_CAPACITY_WARNING_DRAIN_ENABLED:1 --var PUBLICATION_CAPACITY_WARNING_PRODUCER_ENABLED:1 --var DAILY_PUBLICATION_RESERVATION_ENABLED:0 --var DAILY_PUBLICATION_PUT_ENABLED:0 --var DAILY_PUBLICATION_PROMOTION_ENABLED:0",
    "deploy:publication:reservation": "wrangler deploy --var PUBLICATION_CAPACITY_WARNING_DRAIN_ENABLED:1 --var PUBLICATION_CAPACITY_WARNING_PRODUCER_ENABLED:1 --var DAILY_PUBLICATION_RESERVATION_ENABLED:1 --var DAILY_PUBLICATION_PUT_ENABLED:0 --var DAILY_PUBLICATION_PROMOTION_ENABLED:0",
    "deploy:publication:put": "wrangler deploy --var PUBLICATION_CAPACITY_WARNING_DRAIN_ENABLED:1 --var PUBLICATION_CAPACITY_WARNING_PRODUCER_ENABLED:1 --var DAILY_PUBLICATION_RESERVATION_ENABLED:1 --var DAILY_PUBLICATION_PUT_ENABLED:1 --var DAILY_PUBLICATION_PROMOTION_ENABLED:0",
    "deploy:publication:promotion": "wrangler deploy --var PUBLICATION_CAPACITY_WARNING_DRAIN_ENABLED:1 --var PUBLICATION_CAPACITY_WARNING_PRODUCER_ENABLED:1 --var DAILY_PUBLICATION_RESERVATION_ENABLED:1 --var DAILY_PUBLICATION_PUT_ENABLED:1 --var DAILY_PUBLICATION_PROMOTION_ENABLED:1",
    "db:init": "wrangler d1 execute xlist --file=schema.sql --remote",
    "db:init:local": "wrangler d1 execute xlist --file=schema.sql --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "0.27.3",
    "miniflare": "4.20260415.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "disposable-email-domains": "^1.0.62",
    "fflate": "^0.8.2",
    "jose": "^5.10.0",
    "marked": "^18.0.5",
    "nanoid": "^5.1.11",
    "qrcode": "^1.5.4"
  }
}
