# ai-feeds.cc 微信登录中转 —— 环境变量样例
# 部署时复制到 /etc/aifeeds/relay.env，填真值，chmod 600，属主 root（或运行用户）。
# ⚠️ 真值绝不进 git / web root。这里只是占位样例。

# 微信开放平台「网站应用」凭据（与 .secrets/aifeeds-prod.env 的 WECHAT_OPEN_* 一致）
WECHAT_OPEN_APP_ID=wx_你的_appid
WECHAT_OPEN_APP_SECRET=你的_app_secret

# 与 worker 互信的 bridge HMAC 密钥（必须与 worker 的 BRIDGE_SECRET 完全一致；prod / staging 各一个）
BRIDGE_SECRET=与_worker_一致的_hex64

# 给 OAuth 飞行态 cookie 签名（仅 .cc 自用，随机 hex 即可：openssl rand -hex 32）
STATE_SECRET=随机_hex64

# ── 以下都有合理默认值，prod 一般不用改 ──
# 微信回调地址（必须 = 开放平台「授权回调域名」对应的完整 URL）
# WECHAT_REDIRECT_URI=https://ai-feeds.cc/auth/wechat/callback
# worker exchange endpoint（prod 走 api.ai-feeds.com 经香港中转，自动过回源 gate）
# WORKER_EXCHANGE_URL=https://api.ai-feeds.com/api/auth/wechat/exchange
# .com 前端接收 session 的落地路由
# COM_CALLBACK_URL=https://ai-feeds.com/auth/callback
# 登录失败跳回的 .com 登录页
# COM_LOGIN_URL=https://ai-feeds.com/login
# return_to 白名单前缀（逗号分隔，必须 https，防 open redirect）
# RETURN_TO_ALLOWLIST=https://ai-feeds.com/
# 飞行态 cookie 域
# COOKIE_DOMAIN=ai-feeds.cc
# 监听端口（nginx 反代目标）
# PORT=3001

# ── staging 联调时覆盖（指向 staging worker；staging 回源 gate 关闭，可直连）──
# WORKER_EXCHANGE_URL=https://staging-api.ai-feeds.com/api/auth/wechat/exchange
