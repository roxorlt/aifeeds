[Unit]
Description=Publish the AI Feeds mainland static content mirror
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=aifeeds-sync
Group=www
UMask=0027
WorkingDirectory=/opt/aifeeds-cc-sync
EnvironmentFile=/etc/aifeeds/cc-sync.env
ExecStart=/usr/bin/node /opt/aifeeds-cc-sync/sync.mjs
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/lib/aifeeds-cc-sync
ReadWritePaths=/www/wwwroot/ai-feeds.cc/i
