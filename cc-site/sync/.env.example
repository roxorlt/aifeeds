# Copy these names into the service environment. Never commit the real secret.
CC_SYNC_SECRET=replace-with-a-dedicated-random-secret
CC_SYNC_BASE_URL=https://api.ai-feeds.com
CC_SITE_ROOT=/www/wwwroot/ai-feeds.cc
CC_SYNC_STATE_DIR=/var/lib/aifeeds-cc-sync
CC_SYNC_CONCURRENCY=8
CC_SYNC_PAGE_LIMIT=200
CC_SYNC_REQUEST_TIMEOUT_MS=15000

# Keep CC_SYNC_STATE_DIR disjoint from CC_SITE_ROOT so state and lock metadata
# can never become publicly served content.

# Tests only; never enable for a non-loopback host:
# CC_SYNC_ALLOW_INSECURE_LOCALHOST=1

# Deployment invariant: CC_SITE_ROOT/i and generated children must be owned by
# the sync service account (aifeeds-sync) and not group/other-writable.
