<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aifeeds.ph-scraper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/roxor/brain/30-projects/xlist-scraper/scrapers/ph/cron.sh</string>
    </array>

    <!-- TZ 处理：PH leaderboard 按 PT 时区结算，PT 0:30 (= BJT 16:30 PDT /
         17:30 PST) 拉「昨天 PT」榜单。launchd plist 不支持时区直接配，
         需要写 BJT 16:30 的 hour（macOS 跑在 BJT 上）；夏令时/冬令时切换
         需要手动调整 plist hour（PDT 期间 16:30，PST 期间 17:30）。

         ⚠️ 简化方案：用 BJT 16:30（PDT），冬令时进 PST 时榜单可能还没结算
         就抓，需要监控；如发现冬令时数据偏少，把 Hour 改成 17 重新 load。
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>16</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>KeepAlive</key>
    <false/>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/roxor/brain/30-projects/xlist-scraper/data/launchd-ph-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/roxor/brain/30-projects/xlist-scraper/data/launchd-ph-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/roxor/brain/30-projects/xlist-scraper</string>
</dict>
</plist>
